# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 3 MB 应用上限与固定保护分区保持一致。分区表保留
# cardid@0x356000，二创不得移动或覆盖。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本产品界面为文本列表；12KB 够用。RAM 预算（v0.4.21 实测）：
#   编码器 25KB + 流缓冲 8KB 持有后 WiFi init 需 ~37KB，池 16KB 时差 5KB 致 boot loop。
CONFIG_LV_MEM_SIZE_KILOBYTES=12

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- 编译优化：-O2（Performance）---
# ★ v0.4.36 根因修复：IDF 默认是 -Og（Debug），调用链每层栈帧虚胖——
# 真机符号化 5 轮追凶的 opus "16KB 栈"其实是 -Og 产物（libopus -O2 嵌入式
# 典型 4-8KB）。silk 链实测 -Og 下 15.9KB > 借栈洞 14.95KB，恒崩。
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Bluetooth LE / NimBLE ---
# 录音产品不用 BLE（省静态 RAM）。共平台的 ZCode 固件需要时再开。
CONFIG_BT_ENABLED=n

# --- WiFi RAM 预算（会话制 v0.4.27+：录音期 WiFi 整体 deinit，缓冲只在
# 同步窗口存活）---
# 默认 32 个动态 RX 缓冲约 50KB 预分配；10 个足够（吞吐略降，可接受）。
# 静态 RX 保持 3：v0.4.27 夜间实测 6 个反而全断（空闲堆 5.7KB → HTTP 分配
# 失败/lwIP 发包异常/m f null 每 10s）；v0.4.26 用 3 曾真实上传成功。
# 旧结论"TCP 稳定需 ≥6"系误诊——当时症状来自边录边传的 RAM 压力。
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
# v0.4.40：MGMT_SBUF 12→8、RX_MGMT 5→3（省 ~4.2KB）：16KB 常驻编码栈
# 落地后开机空闲堆只剩 7.2KB → wifi:mem fail、空闲 http 瘫痪；修剪后
# 回到 ~11.4KB（v0.4.26-28 实测 10.4KB 可正常校时+上传）。RX_MGMT 3 对
# 稳定 STA 足够（v0.4.x 早期就用的 2）。
# v0.4.42：RX_MGMT 3→2（+1.6KB，v0.4.x 早期原值）：配合流缓冲 8→6KB，
# 空闲水位回到 ~11.7KB——8KB 时 wifi:mem fail（动态收发饿死→上传爬速撞
# timeout，真机实锤）。10.4KB 是 v0.4.26-28 实测可用水位。
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# --- LWIP RAM：给 Opus 编码器(~25KB 状态)腾堆。TCP 收发窗各 5744→3072
# （LWIP sanity 要求 ≥2×MSS=2920；600KB 段上传吞吐仍可；单连接足够）
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=3072
CONFIG_LWIP_TCP_WND_DEFAULT=3072
CONFIG_LWIP_TCP_QUEUE_OOSEQ=n

# --- ZCode 工牌凭据：发布构建一律置空，运行期经 SoftAP 配网写入 NVS ---
# 开发机如需免配网调试，可临时在此填值（勿提交）或 idf.py menuconfig。
CONFIG_ZCODE_WIFI_SSID=""
CONFIG_ZCODE_WIFI_PASS=""
CONFIG_ZCODE_GW_URL=""
CONFIG_ZCODE_GW_TOKEN=""
